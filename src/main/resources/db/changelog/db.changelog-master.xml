<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.31.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1781353950602-1" author="katiavasileva">
        <createSequence incrementBy="1" sequenceName="food_id_seq" startValue="1"/>
    </changeSet>
    <changeSet id="1781353950602-2" author="katiavasileva">
        <createSequence incrementBy="1" sequenceName="users_id_seq" startValue="1"/>
    </changeSet>
    <changeSet id="1781353950602-3" author="katiavasileva">
        <createTable tableName="food">
            <column name="calories" type="DOUBLE precision"/>
            <column name="carbohydrates" type="DOUBLE precision"/>
            <column name="fats" type="DOUBLE precision"/>
            <column name="proteins" type="DOUBLE precision"/>
            <column name="created_at" type="timestamp"/>
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="food_pkey"/>
            </column>
            <column name="updated_at" type="timestamp"/>
            <column name="user_id" type="BIGINT"/>
            <column name="brand" type="VARCHAR(255)"/>
            <column name="food_category" type="VARCHAR(255)"/>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="1781353950602-4" author="katiavasileva">
        <createTable tableName="users">
            <column name="age" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="height" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="weight" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp"/>
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="users_pkey"/>
            </column>
            <column name="activity_factor" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"/>
            <column name="gender" type="VARCHAR(255)"/>
            <column name="name" type="VARCHAR(255)"/>
            <column name="password" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="1781353950602-5" author="katiavasileva">
        <addForeignKeyConstraint baseColumnNames="user_id" baseTableName="food"
                                 constraintName="fkonuv85jhrw21c6y3c9cg0ep6o" onDelete="NO ACTION"
                                 referencedColumnNames="id" referencedTableName="users"/>
    </changeSet>

</databaseChangeLog>